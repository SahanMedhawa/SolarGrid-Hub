<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected -->
    <item android:state_checked="true">

        <shape android:shape="rectangle">

            <corners android:radius="17dp" />

            <solid android:color="#123E43" />

            <stroke
                android:width="2dp"
                android:color="#00E5C3" />

        </shape>

    </item>

    <!-- Unselected -->
    <item>

        <shape android:shape="rectangle">

            <corners android:radius="17dp" />

            <solid android:color="#101F34" />

            <stroke
                android:width="1dp"
                android:color="#172D47" />

        </shape>

    </item>

</selector>