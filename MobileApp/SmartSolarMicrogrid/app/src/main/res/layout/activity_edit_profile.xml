<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/register_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- Brand -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="⚡  SMART SOLAR TRADING"
            android:textColor="@color/register_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="20dp" />

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="@color/register_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update your personal information"
            android:textColor="@color/register_text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp" />


        <!-- NIC INFORMATION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/register_surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/register_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT IDENTIFIER"
                    android:textColor="@color/register_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvEditProfileNic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NIC: Loading..."
                    android:textColor="@color/register_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NIC cannot be changed"
                    android:textColor="@color/register_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONAL INFORMATION"
            android:textColor="@color/register_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />


        <!-- FORM CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/register_surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/register_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">


                <!-- FIRST NAME -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="First Name"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_primary"
                    app:hintTextColor="@color/register_text_secondary"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEditFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- LAST NAME -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Last Name"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_primary"
                    app:hintTextColor="@color/register_text_secondary"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEditLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- EMAIL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email Address"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_primary"
                    app:hintTextColor="@color/register_text_secondary"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEditEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- MOBILE -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mobile Number"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_primary"
                    app:hintTextColor="@color/register_text_secondary"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEditPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ADDRESS -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Physical Address"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_primary"
                    app:hintTextColor="@color/register_text_secondary"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEditAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:minLines="2"
                        android:maxLines="3"
                        android:gravity="top"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- INFORMATION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ  Changes will be saved to your prosumer account."
            android:textColor="@color/register_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp" />


        <!-- SAVE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save Changes  →"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/register_background"
            android:backgroundTint="@color/register_primary"
            app:cornerRadius="11dp" />


        <!-- CANCEL BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEdit"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/register_text_secondary"
            app:strokeColor="@color/register_border"
            app:cornerRadius="11dp" />

    </LinearLayout>

</ScrollView>