<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_login_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <!-- ========================================= -->
        <!-- TOP SPACING -->
        <!-- ========================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="22dp" />

        <!-- ========================================= -->
        <!-- KEY ICON -->
        <!-- ========================================= -->

        <FrameLayout
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_marginBottom="22dp">

            <View
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:background="@drawable/bg_icon_glow_dark" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/dark_surface"
                app:cardCornerRadius="43dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/energy_cyan"
                app:strokeWidth="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔑"
                    android:textSize="38sp"
                    android:textColor="@color/energy_cyan" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- ========================================= -->
        <!-- TITLE -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot "
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/energy_cyan"
                android:textSize="34sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================= -->
        <!-- DESCRIPTION -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your account details to reset your password."
            android:textColor="@color/text_dark_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="30dp" />

        <!-- ========================================= -->
        <!-- ACCOUNT TYPE CONTAINER -->
        <!-- ========================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="@color/dark_surface"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/dark_border"
            app:strokeWidth="1dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <RadioGroup
                android:id="@+id/rgAccountType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="5dp"
                android:weightSum="2">

                <!-- STAFF -->

                <RadioButton
                    android:id="@+id/rbUserType"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_role_selector"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:minLines="2"
                    android:maxLines="2"
                    android:text="♙  Staff&#10;(Backoffice/Operator)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- PROSUMER -->

                <RadioButton
                    android:id="@+id/rbProsumerType"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_role_selector"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:minLines="2"
                    android:maxLines="2"
                    android:text="☀  Solar&#10;Prosumer"
                    android:textColor="@color/text_dark_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </RadioGroup>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================= -->
        <!-- USERNAME / NIC -->
        <!-- ========================================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="26dp"
            android:background="@drawable/bg_dark_input">

            <!-- User icon -->

            <TextView
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="♙"
                android:textColor="@color/icon_blue"
                android:textSize="26sp" />

            <EditText
                android:id="@+id/etUsernameOrNic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="12dp"
                android:background="@android:color/transparent"
                android:hint="Username or NIC"
                android:inputType="text"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_dark_secondary"
                android:textSize="16sp"
                android:singleLine="true" />

        </FrameLayout>

        <!-- ========================================= -->
        <!-- CONTINUE BUTTON -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_login_button"
            android:elevation="5dp"
            android:gravity="center"
            android:text="➜   Continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <!-- ========================================= -->
        <!-- BOTTOM SPACING -->
        <!-- ========================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>

</ScrollView>
