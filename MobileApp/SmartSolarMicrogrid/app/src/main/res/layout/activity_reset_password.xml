<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_login_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <!-- ========================================= -->
        <!-- TOP SPACING -->
        <!-- ========================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="22dp" />

        <!-- ========================================= -->
        <!-- LOCK ICON -->
        <!-- ========================================= -->

        <FrameLayout
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_marginBottom="22dp">

            <!-- Glow -->

            <View
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:background="@drawable/bg_icon_glow_dark" />

            <!-- Circular Icon -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/dark_surface"
                app:cardCornerRadius="43dp"
                app:cardElevation="8dp"
                app:strokeColor="@color/energy_cyan"
                app:strokeWidth="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔒"
                    android:textColor="@color/energy_cyan"
                    android:textSize="38sp" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- ========================================= -->
        <!-- TITLE -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set New "
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/energy_cyan"
                android:textSize="34sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================= -->
        <!-- SUBTITLE -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your new password below."
            android:textColor="@color/text_dark_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- ========================================= -->
        <!-- RESET ACCOUNT INFORMATION -->
        <!-- ========================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="@color/dark_input"
            app:cardCornerRadius="17dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/energy_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <!-- Account icon -->

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="♙"
                    android:textColor="@color/energy_blue"
                    android:textSize="32sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resetting password for:"
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvResetFor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================= -->
        <!-- NEW PASSWORD -->
        <!-- ========================================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_dark_input">

            <!-- Lock icon -->

            <TextView
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🔒"
                android:textColor="@color/icon_blue"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:hint="New Password"
                android:inputType="textPassword"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_dark_secondary"
                android:textSize="16sp"
                android:singleLine="true" />

        </FrameLayout>

        <!-- ========================================= -->
        <!-- CONFIRM PASSWORD -->
        <!-- ========================================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="26dp"
            android:background="@drawable/bg_dark_input">

            <!-- Lock icon -->

            <TextView
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🔒"
                android:textColor="@color/icon_blue"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:hint="Confirm New Password"
                android:inputType="textPassword"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_dark_secondary"
                android:textSize="16sp"
                android:singleLine="true" />

        </FrameLayout>

        <!-- ========================================= -->
        <!-- RESET PASSWORD BUTTON -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_login_button"
            android:elevation="5dp"
            android:gravity="center"
            android:text="➜   Reset Password"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <!-- Bottom spacing -->

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>

</ScrollView>
