<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/register_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Top Action Bar / Back Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivProfileBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/register_text_primary"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back to Dashboard" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⚡  SMART SOLAR TRADING"
                android:textColor="@color/register_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginEnd="40dp" />

        </LinearLayout>

        <!-- Page title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textColor="@color/register_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage your personal information and account"
            android:textColor="@color/register_text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Profile summary -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/register_surface"
            app:strokeColor="@color/register_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="28sp"
                    android:background="@color/register_notice_background" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tvProfileNic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NIC: Loading..."
                        android:textColor="@color/register_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Loading status"
                        android:textColor="@color/register_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Personal information heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONAL INFORMATION"
            android:textColor="@color/register_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />


        <!-- Personal information card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/register_surface"
            app:strokeColor="@color/register_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- First Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="First Name"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_border"
                    app:hintTextColor="@color/register_text_secondary"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProfFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Last Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Last Name"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_border"
                    app:hintTextColor="@color/register_text_secondary"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProfLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email Address"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_border"
                    app:hintTextColor="@color/register_text_secondary"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProfEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Phone -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mobile Number"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_border"
                    app:hintTextColor="@color/register_text_secondary"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProfPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>


                <!-- Address -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Physical Address"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxStrokeColor="@color/register_border"
                    app:hintTextColor="@color/register_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etProfAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:minLines="2"
                        android:gravity="top"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Edit Profile -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateProfile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="✎  Edit Profile"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/energy_cyan"
            app:cornerRadius="18dp"
            android:layout_marginBottom="28dp" />


        <!-- ACCOUNT SECURITY heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT SECURITY"
            android:textColor="@color/register_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />


        <!-- ACCOUNT SECURITY CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/register_surface"
            app:strokeColor="@color/register_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Password"
                    android:textColor="@color/register_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- Current Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCurrentPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Current Password *"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/register_border"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/icon_blue"
                    app:hintTextColor="@color/register_text_secondary"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/icon_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCurrentPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- New Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutNewPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="New Password *"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/register_border"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/icon_blue"
                    app:hintTextColor="@color/register_text_secondary"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/icon_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint"
                        android:hint="Minimum 6 characters" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm New Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutConfirmNewPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Confirm New Password *"
                    app:boxBackgroundColor="@color/register_input"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/register_border"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/icon_blue"
                    app:hintTextColor="@color/register_text_secondary"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/icon_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/register_text_primary"
                        android:textColorHint="@color/register_text_hint" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Change Password Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:backgroundTint="@color/energy_cyan"
                    android:text="Change Password"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Account heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT MANAGEMENT"
            android:textColor="@color/register_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp" />


        <!-- Danger zone -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/register_surface"
            app:strokeColor="@color/register_error"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠  Account Deactivation"
                    android:textColor="@color/register_error"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deactivating your account prevents you from making new reservations. Reactivation requires authorization from a Backoffice Administrator."
                    android:textColor="@color/register_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeactivateAccount"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Deactivate Account"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/register_error"
                    app:strokeColor="@color/register_error"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>