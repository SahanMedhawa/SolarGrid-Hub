<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Title & Status Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Booking Details"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvDetailStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/badge_status_bg"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- QR Code Transaction Pass Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQrPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvQrTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Secure Transaction QR Pass"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp" />

                <!-- Contrast White Container for QR Code (Always crisp white for optical camera scanning in both light/dark mode) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQrContainer"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/qr_background"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:contentDescription="Secure Transaction QR Pass" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Token String & Copy Action -->
                <TextView
                    android:id="@+id/tvQrToken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMTS-XXXX-XXXX"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyToken"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Copy Token"
                    android:textSize="11sp"
                    app:cornerRadius="18dp"
                    android:textColor="@color/accent"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvQrNotice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show this QR code to the Grid Operator at the microgrid station for instant verification."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Booking Specs Detail Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardElevation="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reservation Specifications"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvDetailInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvNoticePolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="* Notice: Modifications and cancellations require at least 12 hours' notice prior to slot time."
                    android:textSize="11sp"
                    android:textColor="@color/status_pending" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:id="@+id/llActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Modify / Reschedule Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModifyReservation"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="✏️  Modify / Reschedule Booking"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:textColor="@color/accent"
                android:layout_marginBottom="10dp" />

            <!-- Cancel Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelReservation"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Cancel Booking"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:strokeColor="@color/status_cancelled"
                android:textColor="@color/status_cancelled" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
