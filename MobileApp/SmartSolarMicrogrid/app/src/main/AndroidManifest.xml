<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSolarMicrogrid"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.prosumer.EditProfileActivity"
            android:exported="false" />

        <!-- Login is the default launcher activity -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.auth.RegisterActivity" />
        <activity android:name=".ui.prosumer.ProsumerMainActivity" />
        <activity android:name=".ui.prosumer.ProfileActivity" />
        <activity android:name=".ui.prosumer.CreateReservationActivity" />
        <activity android:name=".ui.prosumer.ReservationListActivity" />
        <activity android:name=".ui.prosumer.ReservationDetailActivity" />
        <activity android:name=".ui.prosumer.NearbyNodesActivity" />
        <activity android:name=".ui.backoffice.BackofficeMainActivity" />
        <activity android:name=".ui.operator.OperatorMainActivity" />
        <activity
            android:name=".ui.operator.QrScannerActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true" />
        <activity android:name=".ui.operator.ProfileActivity" />
        <activity android:name=".ui.auth.ForgotPasswordActivity" />
        <activity android:name=".ui.auth.ResetPasswordActivity" />

    </application>

</manifest>
